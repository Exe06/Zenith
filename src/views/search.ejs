<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

<body>
  <!-- NAVBAR -->
  <%- include('partials/header') %>

  <!-- FILTROS -->
  <form method="GET" action="/property/search" id="filters" class="filters-wrap">
    <div class="filters" id="filters">
      <div class="filter" style="grid-column:span 2">
        <label for="fTipo">Tipo</label>
        <select id="fTipo" name="tipo">
          <option value="">Todos</option>
          <option value="1">Casa</option>
          <option value="2">Departamento</option>
          <option value="3">Monoambiente</option>
        </select>
      </div>

      <div class="filter" style="grid-column:span 2">
        <label for="fOperacion">Operación</label>
        <select id="fOperacion" name="op">
          <option value="">Cualquiera</option>
          <option value="1">Largo Plazo</option>
          <option value="2">Temporal</option>
        </select>
      </div>

      <div class="filter" style="grid-column:span 2">
        <label for="fGarantia">Garantía</label>
        <select id="fGarantia" name="garantia">
          <option value="">Cualquiera</option>
          <option value="1">Propietario</option>
          <option value="2">Seguro de caución</option>
          <option value="3">Aval Bancario</option>
        </select>
      </div>

      <div class="filter" style="grid-column:span 1">
        <label for="fAmb">Ambientes (mín.)</label>
        <select id="fAmb" name="amb">
          <option value="">—</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
        </select>
      </div>

      <div class="filter" style="grid-column:span 1">
        <label for="fDorm">Dorm. (mín.)</label>
        <select id="fDorm" name="dorm">
          <option value="">—</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
        </select>
      </div>

      <div class="filter" style="grid-column:span 1">
        <label for="fProv">Provincia</label>
        <select id="fProv" name="provincia">
          <option value="">Todas</option>
          <% provincias.forEach(prov => { %>
            <option value="<%= prov %>"><%= prov %></option>
          <%  }); %>
        </select>
      </div>

      <div class="filter" style="grid-column:span 2">
        <label for="fPrecio">Precio máx.</label>
        <select id="fPrecio" name="max_price">
          <option value="">Sin tope</option>
          <option value="150000">Hasta $150.000</option>
          <option value="250000">Hasta $250.000</option>
          <option value="350000">Hasta $350.000</option>
          <option value="500000">Hasta $500.000</option>
        </select>
      </div>

      <select name="sort">
        <option value="newest">Más recientes</option>
        <option value="price_asc">Precio ↑</option>
        <option value="price_desc">Precio ↓</option>
      </select>

      <div class="filter" style="grid-column:span 6">
        <div class="checkline">
          <label><input type="checkbox" class="srv" name="svc" value="mascota"> Mascotas</label>
          <label><input type="checkbox" class="srv" name="svc" value="garage"> Cochera</label>
          <label><input type="checkbox" class="srv" name="svc" value="balcon"> Balcón</label>

          <label><input type="checkbox" class="srv" name="svc" value="internet"> Internet</label>
          <label><input type="checkbox" class="srv" name="svc" value="gas"> Gas</label>
          <label><input type="checkbox" class="srv" name="svc" value="luz"> Luz</label>
          <label><input type="checkbox" class="srv" name="svc" value="agua"> Agua</label>
        </div>
      </div>

      <button type="submit">Filtrar</button>
    </div>
  </form>

  <!-- CONTENIDO -->
  <main class="container">
    <h1 class="title">Propiedades Disponibles</h1>

    <% if (!properties || !properties.length) { %>
      <div class="card section">No encontramos propiedades.</div>
    <% } else { %>
      <section id="grid" class="grid">
        <!-- 8 TARJETAS DE EJEMPLO -->
        <!-- data-servicios es lista separada por coma -->
        <% properties.forEach(p => { %>
          <article class="prop-card card-propiedad">
            <div class="img"><img src="/img/properties/<%=p.images[0].filename%>" alt="<%=p.images[0].filename%>"></div>
            <div class="body">
              <h3><%= p.titulo %></h3>
              <p class="muted"><%= p.descripcion %></p>
              <div class="meta">
                <span class="chip"><%= p.provincia %></span>
                <span class="chip"><%= p.ambientes %> amb</span>
                <% if (p.balcon) { %><span class="chip">Balcón</span><% } %>
                <% if (p.mascotas) { %><span class="chip">Mascotas</span><% } %>
                <% if (p.cochera) { %><span class="chip">Cochera</span><% } %>
              </div>
            </div>
            <div class="card-actions">
              <span class="price">$<%= p.monto_base ? p.monto_base : p.precio_diario %></span>
              <a class="btn btn-primary" href="/property/<%= p.id %>">Ver propiedad</a>
            </div>
          </article>
        <% }) %>
      </section>
    <% } %>
  </main>

  <!-- <script src="/js/search.js"></script> -->
</body>
</html>

