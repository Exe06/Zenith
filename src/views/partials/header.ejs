<header class="navbar">
    <div class="logo"><a href="/">Zenit <span>Alquileres</span></a></div>
    <nav>
      <ul>
        <% if (!locals.user) { %>
          <li><a href="/user/login" class="btn-inicio-sesion">Iniciar Sesión</a></li>
        <% } else if (locals.user.roles.includes("Propietario")) { %>
          <li><a href="/user/managment">Propiedades</a></li>
          <li><a href="/user/panel">Mis Alquileres</a></li>
          <li><a href="/user/profile"><img src="/img/users/<%= locals.user.imagen %>" alt="Foto de perfil" class="profile-img"></a></li>
        <% } else if (locals.user.roles.includes("Administrador")) { %>
          <li><a href="/admin">Panel Admin</a></li>
          <li><a href="/user/profile"><img src="/img/users/<%= locals.user.imagen %>" alt="Foto de perfil" class="profile-img"></a></li>
        <% } else { %>
          <li><a href="/user/panel">Mis Alquileres</a></li>
          <li><a href="/user/profile"><img src="/img/users/<%= locals.user.imagen %>" alt="Foto de perfil" class="profile-img"></a></li>
        <% } %>
      </ul>
    </nav>

</header>