<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

<body>

  <%- include('partials/header') %>

  <div class="perfil-container">
    
    <!-- VISTA DEL PERFIL -->
    <div class="perfil-view">
      <img src="/img/users/<%= locals.user.imagen %>" alt="Avatar" class="avatar">
      <h2><%= locals.user.nombre %></h2>
      <p><strong>Email:</strong> <%= locals.user.email %></p>
      <p><strong>Provincia:</strong> <%= locals.user.provincia %></p>
    </div>

    <!-- FORMULARIO PARA EDITAR -->
    <div class="perfil-form">
      <h2>Editar Perfil</h2>
      <form action="/user/<%= locals.user.id %>?_method=PATCH" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label for="avatar">Foto de Perfil</label>
          <input type="file" id="avatar" name="avatar" accept="image/*" />
        </div>

        <div class="form-group">
          <label for="nombre">Nombre</label>
          <input type="text" id="nombre" name="nombre" placeholder="Ej: Juan" value="<%= locals.user.nombre %>" />
        </div>

        <div class="form-group">
          <label for="apellido">Apellido</label>
          <input type="text" id="apellido" name="apellido" placeholder="Ej: Pérez" value="<%= locals.user.apellido %>" />
        </div>

        <div class="form-group">
          <label for="telefono">Telefono</label>
          <input type="number" id="telefono" name="telefono" placeholder="Ej: 1234567890" value="<%= locals.user.telefono %>" />
        </div>

        <div class="form-group">
          <label for="provincia">Provincia</label>
          <select id="provincia" name="provincia" required>
            <% provincias.forEach(p => {  %>
              <option value="<%= p %>" <% if (locals.user.provincia === p) { %> selected <% } %>><%= p %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <button type="submit">Guardar Cambios</button>
        </div>
      </form>
    </div>

  </div>
</body>
</html>
