<!DOCTYPE html>
<html lang="es">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <div class="container">
      <div>
        <h1>Detalle del Contrato</h1>
        <div
          class="sub"
          style="
            display: flex;
            justify-content: space-between;
            align-items: center;
          "
        >
          <span><%= contract.property.titulo %></span>
          <span class="status st-<%= contract.estado.toLowerCase() %>"
            ><%= contract.estado %></span
          >
        </div>

        <section class="card section" style="margin-top: 24px">
          <div class="row" style="justify-content: space-around; gap: 16px">
            <div class="info-box" style="text-align: center">
              <strong class="muted">PROPIETARIO</strong>
              <h4>
                <%= contract.owner.nombre %> <%= contract.owner.apellido %>
              </h4>
              <span><%= contract.owner.email %></span>
            </div>
            <div class="info-box" style="text-align: center">
              <strong class="muted">INQUILINO</strong>
              <h4>
                <%= contract.tenant.nombre %> <%= contract.tenant.apellido %>
              </h4>
              <span><%= contract.tenant.email %></span>
            </div>
            <div class="info-box" style="text-align: center">
              <strong class="muted">PROPIEDAD</strong>
              <h4><%= contract.property.titulo %></h4>
              <span><%= contract.property.direccion %></span>
            </div>
          </div>
        </section>

        <section class="card section">
          <h3>Términos del Contrato</h3>
          <div
            class="detail-grid"
            style="
              display: grid;
              grid-template-columns: repeat(4, 1fr);
              gap: 20px;
              margin-top: 15px;
            "
          >
            <div class="info-box">
              <strong>Tipo de Contrato</strong>
              <p><%= contract.contract_type %></p>
            </div>
            <div class="info-box">
              <strong>Inicio</strong>
              <p>
                <%= new Date(contract.start_date).toLocaleDateString('es-AR') %>
              </p>
            </div>
            <div class="info-box">
              <strong>Fin</strong>
              <p>
                <%= new Date(contract.end_date).toLocaleDateString('es-AR') %>
              </p>
            </div>
            <div class="info-box">
              <strong>Frecuencia de Pago</strong>
              <p><%= contract.pay_frequency %></p>
            </div>
            <div class="info-box">
              <strong>Pago Inicial (Monto Base)</strong>
              <p>
                <%= contract.monto_base ?
                contract.monto_base.toLocaleString('es-AR', {style:'currency',
                currency:'ARS'}) : 'N/A' %>
              </p>
            </div>
            <div class="info-box">
              <strong>Cuota Mensual (Depósito)</strong>
              <p>
                <%= contract.deposito ?
                contract.deposito.toLocaleString('es-AR', {style:'currency',
                currency:'ARS'}) : 'N/A' %>
              </p>
            </div>
            <div class="info-box">
              <strong>Precio Diario (Temporal)</strong>
              <p>
                <%= contract.daily_price ?
                contract.daily_price.toLocaleString('es-AR', {style:'currency',
                currency:'ARS'}) : 'N/A' %>
              </p>
            </div>
            <div class="info-box">
              <strong>Tasa Mora Diaria</strong>
              <p><%= contract.interest_rate || 0 %> %</p>
            </div>
          </div>
        </section>

        <section class="tabs" style="margin-top: 24px">
          <div class="tab-head">
            <h3>Plan de Pagos</h3>
          </div>
          <div class="tab-pane active">
            <div class="table-wrap">
              <table id="tablaPagos">
                <thead>
                  <tr>
                    <th>Vencimiento</th>
                    <th>Concepto</th>
                    <th>Monto a Pagar</th>
                    <th>Fecha de Pago</th>
                    <th>Estado</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="tbPagos">
                  <% if (contract.payments && contract.payments.length > 0) { %>
                    <% contract.payments.forEach(payment => { %> 
                      <%
                        let estadoCalculado = 'pagado';
                        let montoMostrado = parseFloat(payment.amount);
                        if (!payment.paid_date) {
                          const hoy = new Date();
                          hoy.setHours(0, 0, 0, 0); 
                          const vencimiento = new Date(payment.due_date);
                          vencimiento.setHours(0, 0, 0, 0);

                          if (hoy > vencimiento) {
                            estadoCalculado = 'atrasado';

                            const diasDeMora = (hoy - vencimiento) / (1000 * 60 * 60 * 24);
                            const tasaDiaria = parseFloat(contract.interest_rate || 0) / 100;

                            if (tasaDiaria > 0) {
                              const mora = montoMostrado * tasaDiaria * diasDeMora;
                              montoMostrado = montoMostrado + mora;
                            }
                          } else {
                            estadoCalculado = 'pendiente';
                          }
                        } 
                      %> 

                  <tr class="data-row" data-estado="<%= estadoCalculado %>">
                    <td>
                      <%= new Date(payment.due_date).toLocaleDateString('es-AR') %>
                    </td>
                    <td><%= payment.description || 'Cuota' %></td>
                    <td>
                      <%= montoMostrado.toLocaleString('es-AR', {style:
                      'currency', currency: 'ARS'}) %>
                    </td>
                    <td>
                      <%= payment.paid_date ? new
                      Date(payment.paid_date).toLocaleDateString('es-AR') :
                      '---' %>
                    </td>
                    <td>
                      <span class="status st-<%= estadoCalculado %>"><%= estadoCalculado %></span>
                    </td>
                    <td class="actions">
                      <% if (estadoCalculado === 'pagado') { %>
                        <a></a>
                      <% } else if (user.id === contract.tenant_id) { %>
                        <a href="/payments/pay/<%= payment.id %>" class="btn btn-primary">Pagar</a>
                      <% } else if (user.id === contract.owner_id) { %>

                      <% } %>
                    </td>
                  </tr>
                  <% }) %>
                  <% } else { %>
                    <tr class="no-results-row">
                      <td colspan="6" style="text-align: center">
                        No hay un plan de pagos generado para este contrato.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

      </div>
    </div>

    <%- include('partials/footer') %>
  </body>
</html>
