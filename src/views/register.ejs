<!DOCTYPE html>
<html lang="es">

<%- include('partials/head') %>

<body>

  <%- include('partials/header') %>

  <section>
    <div class="form-wrapper">
      <!-- Formulario -->
      <div class="container">
        <h1>Registro de Usuario</h1>
        <p>¡Comienza tu experiencia con Zenit Alquileres hoy mismo!</p>

        <form action="/user/register" method="POST" novalidate>

          <label for="apellido">Apellido*</label>
          <input type="text" id="apellido" name="apellido" value="<%= locals.old && old.apellido %>" required />
          <% if (locals.errors && errors.apellido) { %>
            <span class="form-error"> <%= errors.apellido.msg %> </span>
          <% } %>
          <span class="form-error"></span>

          <label for="nombre">Nombre*</label>
          <input type="text" id="nombre" name="nombre" value="<%= locals.old && old.nombre %>" required />
          <% if (locals.errors && errors.nombre) { %>
            <span class="form-error"> <%= errors.nombre.msg %> </span>
          <% } %>
          <span class="form-error"></span>

          <label for="dni">DNI*</label>
          <input type="number" id="dni" name="dni" value="<%= locals.old && old.dni %>" required />
          <% if (locals.errors && errors.dni) { %>
            <span class="form-error"> <%= errors.dni.msg %> </span>
          <% } %>
          <span class="form-error"></span>

          <label for="email">Email*</label>
          <input type="email" id="email" name="email" value="<%= locals.old && old.email %>" required />
          <% if (locals.errors && errors.email) { %>
            <span class="form-error"> <%= errors.email.msg %> </span>
          <% } %>
          <span class="form-error"></span>

          <label for="password">Contraseña*</label>
          <input type="password" id="password" name="password" required />
          <% if (locals.errors && errors.password) { %>
            <span class="form-error"> <%= errors.password.msg %> </span>
          <% } %>
          <span class="form-error"></span>

          <label for="telefono">Teléfono</label>
          <input type="number" id="telefono" name="telefono" value="<%= locals.old && old.telefono %>" />
          <% if (locals.errors && errors.telefono) { %>
            <span class="form-error"> <%= errors.telefono.msg %> </span>
          <% } %>
          <span class="form-error"></span>

          <label for="provincia">Provincia*</label>
          <select name="provincia" id="provincia" required>
            <option value="" selected>Seleccione una provincia</option>
            <% provincias.forEach(p => {  %>
              <option value="<%= p %>"><%= p %></option>
            <% }) %>
          </select>
          <% if (locals.errors && errors.provincia) { %>
            <span class="form-error"> <%= errors.provincia.msg %> </span>
          <% } %>

          <br>

          <button type="submit">Registrarse</button>
        </form>
        <p>Los campos con (*) son obligatorios.</p>
      </div>
    </div>
  </section>
</body>
</html>
