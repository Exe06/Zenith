<!DOCTYPE html>
<html lang="es">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>

    <section class="user-dashboard">

      <aside class="profile-panel">
        <div class="profile-card">
          <div class="avatar">
            <img src="/img/users/<%= locals.user.imagen %>" alt="Foto de perfil" />
          </div>

          <div class="profile-body">
            <h2 class="name"><%= locals.user.nombre %> <%= locals.user.apellido %></h2>
            <p class="role"><%= locals.user.roles %></p>

            <div class="profile-info">
              <p><strong>DNI:</strong> <%= locals.user.dni %></p>
              <p><strong>Email:</strong> <%= locals.user.email %></p>
              <p><strong>Teléfono:</strong> <%= locals.user.telefono %></p>
              <p><strong>Provincia:</strong> <%= locals.user.provincia %></p>
            </div>

            <div class="profile-actions">
              <a class="btn edit" href="/user/edit/<%= locals.user.id %>">Editar perfil</a>
              <a class="btn logout" href="/user/logout">Cerrar Sesión</a>
            </div>
            <div class="danger-zone">
              <form action="/user/<%= locals.user.id %>?_method=DELETE" method="POST" onsubmit="return confirm('¿Estás SEGURO de que querés eliminar tu cuenta? Esta acción es permanente.');">
                <button type="submit" class="btn delete">Eliminar mi cuenta</button>
              </form>
            </div>
          </div>
        </div>
      </aside>  
    </section>
    <!-- <script src="/js/profile.js"></script> -->
  </body>
</html>